UI_GALLERY=1
APP_ORIGIN=http://127.0.0.1:8787
# session cookie の署名鍵。32 文字以上必須（短いと全ページ 500）。下はローカル用のダミー値。
# 本番は `openssl rand -base64 32` の値を `wrangler secret put SESSION_SECRET` で入れる
SESSION_SECRET=local-dev-session-secret-change-me-0123
AUTH_DEV_LOGIN=1
# LAN の開発機 IP から仮ログインするとき（例 10.1.111.70）。APP_ORIGIN もその IP にする。起動中は同じ LAN の誰でもオーナーで入れる点に注意
AUTH_DEV_HOSTS=
OWNER_IDENTITIES=dev:owner
# Google の OAuth クライアント。CLIENT_ID が空なら Google ログインは「準備中」
GOOGLE_CLIENT_ID=
# secret。本番は `wrangler secret put GOOGLE_CLIENT_SECRET` で入れる
GOOGLE_CLIENT_SECRET=
# Discord の OAuth クライアント。CLIENT_ID が空なら Discord ログインは「準備中」
DISCORD_CLIENT_ID=
# secret。本番は `wrangler secret put DISCORD_CLIENT_SECRET` で入れる
DISCORD_CLIENT_SECRET=
